<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="generator" content="mcpprobe {{ version }}">
<title>MCPProbe report</title>
<style>
:root {
  --bg: #fbfaf8; --panel: #ffffff; --text: #1d1d1b; --muted: #6b6a66; --line: #e4e2dc;
  --fail: #b42318; --fail-bg: #fdecea; --warn: #8a5a00; --warn-bg: #fff4dc;
  --note: #1f5f99; --note-bg: #e8f1fb; --pass: #2e6b3a; --pass-bg: #e8f4ea;
  --code-bg: #f3f1ec;
}
@media (prefers-color-scheme: dark) {
  :root {
    --bg: #161614; --panel: #1f1f1c; --text: #ecebe6; --muted: #a3a29c; --line: #34332f;
    --fail: #ff8a80; --fail-bg: #3a1c1a; --warn: #f2c26b; --warn-bg: #362b14;
    --note: #8cc2ff; --note-bg: #182a3d; --pass: #8fd19e; --pass-bg: #1b3020;
    --code-bg: #2a2925;
  }
}
* { box-sizing: border-box; }
body { margin: 0; background: var(--bg); color: var(--text);
  font: 15px/1.5 system-ui, -apple-system, "Segoe UI", sans-serif; }
main { max-width: 980px; margin: 0 auto; padding: 32px 16px 64px; }
h1 { font-size: 24px; margin: 0 0 4px; letter-spacing: -0.01em; }
h2 { font-size: 17px; margin: 36px 0 12px; }
.sub { color: var(--muted); margin: 0 0 24px; }
.verdict { display: inline-block; font-weight: 600; padding: 2px 10px; border-radius: 999px; }
.verdict.ok { color: var(--pass); background: var(--pass-bg); }
.verdict.bad { color: var(--fail); background: var(--fail-bg); }
dl.meta { display: grid; grid-template-columns: max-content 1fr; gap: 4px 16px; margin: 16px 0; }
dl.meta dt { color: var(--muted); }
dl.meta dd { margin: 0; overflow-wrap: anywhere; }
.tiles { display: grid; grid-template-columns: repeat(auto-fit, minmax(110px, 1fr)); gap: 8px; }
.tile { background: var(--panel); border: 1px solid var(--line); border-radius: 8px; padding: 10px 12px; }
.tile b { display: block; font-size: 22px; font-variant-numeric: tabular-nums; }
.tile span { color: var(--muted); font-size: 13px; }
.item { background: var(--panel); border: 1px solid var(--line); border-left-width: 4px;
  border-radius: 8px; padding: 12px 14px; margin: 0 0 10px; }
.item.finding { border-left-color: var(--fail); }
.item.warning { border-left-color: var(--warn); }
.item.note { border-left-color: var(--note); }
.item.error { border-left-color: var(--fail); }
.head { display: flex; flex-wrap: wrap; gap: 6px 10px; align-items: baseline; }
.id { font-family: ui-monospace, "SF Mono", Consolas, monospace; font-weight: 600; overflow-wrap: anywhere; }
.badge { font-size: 12px; padding: 1px 8px; border-radius: 999px; white-space: nowrap; }
.badge.finding, .badge.error { color: var(--fail); background: var(--fail-bg); }
.badge.warning { color: var(--warn); background: var(--warn-bg); }
.badge.note { color: var(--note); background: var(--note-bg); }
.badge.known { color: var(--muted); background: var(--code-bg); }
.title { color: var(--muted); }
.msg { white-space: pre-wrap; overflow-wrap: anywhere; margin: 8px 0 0; }
code, .cmd { font-family: ui-monospace, "SF Mono", Consolas, monospace; font-size: 13px; }
.cmd { display: block; background: var(--code-bg); padding: 6px 10px; border-radius: 6px;
  margin-top: 8px; overflow-x: auto; white-space: pre; }
a { color: var(--note); }
details { margin-top: 28px; }
summary { cursor: pointer; font-weight: 600; }
table { width: 100%; border-collapse: collapse; margin-top: 10px; font-size: 14px; }
td { border-top: 1px solid var(--line); padding: 6px 8px; vertical-align: top; overflow-wrap: anywhere; }
td.st { white-space: nowrap; color: var(--muted); }
.empty { color: var(--muted); }
</style>
</head>
<body>
<main>
<h1>MCPProbe report</h1>
<p class="sub">
  <span class="verdict {{ 'ok' if exit_code == 0 else 'bad' }}">{{ verdict }}</span>
  &nbsp;exit code {{ exit_code }}
</p>
<dl class="meta">
  <dt>Server</dt><dd><code>{{ server }}</code></dd>
  <dt>Era</dt><dd>{{ era }}</dd>
  <dt>Seed</dt><dd><code>{{ seed }}</code> (rerun with <code>--seed {{ seed }}</code> for the same report)</dd>
  {% if baseline is not none %}<dt>Baseline</dt><dd>{{ baseline }} known finding(s); only new ones fail the run</dd>{% endif %}
  <dt>MCPProbe</dt><dd>{{ version }}</dd>
</dl>
<div class="tiles">
  {% for label, value in tiles %}<div class="tile"><b>{{ value }}</b><span>{{ label }}</span></div>{% endfor %}
</div>

{% for section in sections %}
<h2>{{ section.title }} ({{ section.entries | length }})</h2>
{% if not section.entries %}<p class="empty">{{ section.empty }}</p>{% endif %}
{% for item in section.entries %}
<div class="item {{ item.kind }}">
  <div class="head">
    <span class="id">{{ item.id }}</span>
    <span class="badge {{ item.kind }}">{{ item.label }}</span>
    {% if item.known %}<span class="badge known">in baseline</span>{% endif %}
    <span class="title">{{ item.title }}</span>
  </div>
  {% if item.message %}<p class="msg">{{ item.message }}</p>{% endif %}
  {% if item.repro %}<code class="cmd">{{ item.repro }}</code>{% endif %}
  {% if item.spec %}<div><a href="{{ item.spec }}">Spec section</a></div>{% endif %}
</div>
{% endfor %}
{% endfor %}

<details>
  <summary>Passed and skipped ({{ rest | length }})</summary>
  <table>
    {% for item in rest %}
    <tr><td class="id">{{ item.id }}</td><td class="st">{{ item.label }}</td><td>{{ item.message or item.title }}</td></tr>
    {% endfor %}
  </table>
</details>
</main>
</body>
</html>
